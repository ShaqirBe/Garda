<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="main-content" class="page-shell menu-page">
  <section class="menu-page-intro">
    <p class="eyebrow" data-i18n="menuPage.eyebrow"></p>
    <h1 data-i18n="menuPage.title"></h1>
    <p data-i18n="menuPage.intro"></p>
  </section>

  <section class="menu-document-grid" aria-label="Speisekarten">
    <article class="menu-document-card">
      <p class="menu-document-kicker" data-i18n="menuPage.eis.kicker"></p>
      <h2 data-i18n="menuPage.eis.title"></h2>
      <p data-i18n="menuPage.eis.desc"></p>
      <a
        class="btn btn-call"
        href="/menus/eiskarte-garda.pdf"
        target="_blank"
        rel="noopener noreferrer"
        data-i18n="menuPage.openPdf"
      ></a>
      <a
        class="menu-download"
        href="/menus/eiskarte-garda.pdf"
        download
        data-i18n="menuPage.downloadPdf"
      ></a>
    </article>

    <article class="menu-document-card menu-document-card-waffle">
      <p class="menu-document-kicker" data-i18n="menuPage.waffle.kicker"></p>
      <h2 data-i18n="menuPage.waffle.title"></h2>
      <p data-i18n="menuPage.waffle.desc"></p>
      <a
        class="btn btn-call"
        href="/menus/bruesseler-waffeln-garda.pdf"
        target="_blank"
        rel="noopener noreferrer"
        data-i18n="menuPage.openPdf"
      ></a>
      <a
        class="menu-download"
        href="/menus/bruesseler-waffeln-garda.pdf"
        download
        data-i18n="menuPage.downloadPdf"
      ></a>
    </article>
  </section>
</main>

<%- include('partials/footer') %>
