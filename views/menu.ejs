<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="main-content" class="page-shell menu-page">
  <section class="menu-page-intro">
    <p class="eyebrow" data-i18n="menuPage.eyebrow"></p>
    <h1 data-i18n="menuPage.title"></h1>
    <p data-i18n="menuPage.intro"></p>
  </section>

  <section class="menu-document-grid" aria-label="Speisekarten">
    <article class="menu-document-card">
      <p class="menu-document-kicker" data-i18n="menuPage.eis.kicker"></p>
      <h2 data-i18n="menuPage.eis.title"></h2>
      <p data-i18n="menuPage.eis.desc"></p>
      <a
        class="btn btn-call"
        href="/menus/eiskarte-garda.pdf"
        target="_blank"
        rel="noopener noreferrer"
        data-i18n="menuPage.openPdf"
      ></a>
      <a
        class="menu-download"
        href="/menus/eiskarte-garda.pdf"
        download
        data-i18n="menuPage.downloadPdf"
      ></a>
    </article>

    <article class="menu-document-card menu-document-card-waffle">
      <p class="menu-document-kicker" data-i18n="menuPage.waffle.kicker"></p>
      <h2 data-i18n="menuPage.waffle.title"></h2>
      <p data-i18n="menuPage.waffle.desc"></p>
      <a
        class="btn btn-call"
        href="/menus/bruesseler-waffeln-garda.pdf"
        target="_blank"
        rel="noopener noreferrer"
        data-i18n="menuPage.openPdf"
      ></a>
      <a
        class="menu-download"
        href="/menus/bruesseler-waffeln-garda.pdf"
        download
        data-i18n="menuPage.downloadPdf"
      ></a>
    </article>
  </section>

  <section class="online-menu" aria-labelledby="online-menu-title">
    <div class="online-menu-heading">
      <p class="eyebrow">Direkt online</p>
      <h2 id="online-menu-title">Unsere Speisekarte</h2>
      <p>
        Entdecken Sie unsere Auswahl direkt auf der Seite. Alle Preise in Euro.
        Änderungen und saisonale Verfügbarkeit vorbehalten.
      </p>
    </div>

    <nav class="online-menu-nav" aria-label="Kategorien der Speisekarte">
      <% onlineMenu.forEach((section) => { %>
        <a href="#<%= section.id %>"><%= section.shortTitle %></a>
      <% }); %>
    </nav>

    <% onlineMenu.forEach((section) => { %>
      <section id="<%= section.id %>" class="online-menu-section">
        <div class="online-menu-section-heading">
          <p class="eyebrow"><%= section.kicker %></p>
          <h2><%= section.title %></h2>
          <% if (section.note) { %>
            <p><%= section.note %></p>
          <% } %>
        </div>

        <div class="online-menu-items <%= section.layout || "" %>">
          <% section.items.forEach((item) => { %>
            <article class="online-menu-item">
              <div>
                <h3><%= item.name %></h3>
                <% if (item.description) { %>
                  <p><%= item.description %></p>
                <% } %>
              </div>
              <% if (item.price) { %>
                <strong><%= item.price %></strong>
              <% } %>
            </article>
          <% }); %>
        </div>
      </section>
    <% }); %>
  </section>
</main>

<%- include('partials/footer') %>
