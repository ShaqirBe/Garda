<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="main-content" class="page-shell menu-page">
  <section class="menu-page-intro">
    <p class="eyebrow" data-i18n="menuPage.eyebrow"></p>
    <h1 data-i18n="menuPage.title"></h1>
    <p data-i18n="menuPage.intro"></p>
  </section>

  <div class="menu-tabs" role="tablist" aria-label="Speisekategorien">
    <% menu.categories.forEach((category, idx) => { %>
      <button
        class="tab-btn <%= idx === 0 ? 'active' : '' %>"
        data-target="<%= category.key %>"
        role="tab"
        aria-selected="<%= idx === 0 ? 'true' : 'false' %>"
        data-i18n="menuPage.tabs.<%= category.key %>"
      ></button>
    <% }) %>
  </div>

  <% menu.categories.forEach((category, idx) => { %>
    <section
      class="menu-section tab-content <%= idx === 0 ? 'active' : '' %>"
      id="<%= category.key %>"
      role="tabpanel"
      <%= idx !== 0 ? 'hidden' : '' %>
    >
      <h2 data-i18n="menuPage.tabs.<%= category.key %>"></h2>
      <% category.items.forEach(item => { %>
        <div class="menu-item">
          <div class="menu-header">
            <span class="menu-title"><%= item.name %></span>
            <span class="menu-price"><%= item.price %></span>
          </div>
          <div class="menu-ingredients"><%= item.desc %></div>
        </div>
      <% }) %>
    </section>
  <% }) %>
</main>

<script src="/js/tabs.js"></script>
<%- include('partials/footer') %>
