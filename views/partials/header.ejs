<a class="skip-link" href="#main-content">Zum Inhalt springen</a>
<header class="site-header">
  <div class="site-header-inner">
    <a href="/" class="brand" aria-label="Zur Startseite">
      <div class="mark">G</div>
      <div class="brand-text">
        <span class="brand-kicker" data-i18n="tagline"></span>
        <span class="brand-name"><%= site.name %></span>
      </div>
    </a>

    <nav class="site-nav" aria-label="Hauptnavigation">
      <a class="<%= currentPath === '/' ? 'active' : '' %>" href="/" data-i18n="nav.home" <%= currentPath === '/' ? 'aria-current="page"' : '' %>></a>
      <a class="<%= currentPath === '/menu' ? 'active' : '' %>" href="/menu" data-i18n="nav.menu" <%= currentPath === '/menu' ? 'aria-current="page"' : '' %>></a>
      <a class="<%= currentPath === '/kontakt' ? 'active' : '' %>" href="/kontakt" data-i18n="nav.contact" <%= currentPath === '/kontakt' ? 'aria-current="page"' : '' %>></a>
      <a class="<%= currentPath === '/impressum' ? 'active' : '' %>" href="/impressum" data-i18n="nav.legal" <%= currentPath === '/impressum' ? 'aria-current="page"' : '' %>></a>
    </nav>

    <div class="lang-switch">
      <button class="lang" data-lang="de">DE</button>
      <button class="lang" data-lang="en">EN</button>
    </div>
  </div>
</header>
