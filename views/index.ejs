<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="main-content">
  <section class="hero">
    <div class="hero-text" data-animate>
      <p class="eyebrow" data-i18n="heroEyebrow"></p>
      <h1 data-i18n="heroTitle"></h1>
      <p class="lead" data-i18n="heroIntro"></p>
      <div class="hero-actions">
        <a class="btn btn-call call-link" href="#" data-i18n="callLabel"></a>
        <a class="btn btn-ghost" href="/menu" data-i18n="cta.menu"></a>
      </div>
      <p class="note" data-i18n="heroNote"></p>
    </div>
    <div class="hero-media" data-animate>
      <img
        src="/images/hero-garda-lake.jpg"
        alt="Garda hero"
        class="hero-image"
      />
    </div>
  </section>

  <section class="feature-strip" data-animate>
    <div class="feature-card">
      <h3 data-i18n="featureStrip.0.title"></h3>
      <p data-i18n="featureStrip.0.desc"></p>
    </div>
    <div class="feature-card">
      <h3 data-i18n="featureStrip.1.title"></h3>
      <p data-i18n="featureStrip.1.desc"></p>
    </div>
    <div class="feature-card">
      <h3 data-i18n="featureStrip.2.title"></h3>
      <p data-i18n="featureStrip.2.desc"></p>
    </div>
  </section>

  <section class="promo-grid" data-animate>
    <div class="promo-card">
      <div class="promo-media">
        <img src="/images/promo-affogato.jpg" alt="Ice caffe" />
      </div>
      <h3 data-i18n="promoBlocks.0.title"></h3>
      <p data-i18n="promoBlocks.0.desc"></p>
      <a class="text-link" href="/kontakt" data-i18n="cta.story"></a>
    </div>
    <div class="promo-card">
      <div class="promo-media">
        <img src="/images/promo-gelato.jpg" alt="Gelato" />
      </div>
      <h3 data-i18n="promoBlocks.1.title"></h3>
      <p data-i18n="promoBlocks.1.desc"></p>
      <a class="text-link" href="/menu" data-i18n="cta.menu"></a>
    </div>
    <div class="promo-card">
      <div class="promo-media">
        <img src="/images/promo-waffle.jpg" alt="Waffle" />
      </div>
      <h3 data-i18n="promoBlocks.2.title"></h3>
      <p data-i18n="promoBlocks.2.desc"></p>
      <a class="text-link" href="/kontakt" data-i18n="cta.story"></a>
    </div>
  </section>

  <section id="menu" class="menu">
    <div class="section-head" data-animate>
      <h2 data-i18n="menuTitle"></h2>
      <p data-i18n="menuIntro"></p>
    </div>
    <div class="menu-grid">
      <div class="menu-card" data-animate>
        <h3 data-i18n="menuPage.tabs.iceCaffe"></h3>
        <ul>
          <li>Affogato Garda</li>
          <li>Ice Latte Vanilla</li>
          <li>Cold Brew Tiramisu</li>
        </ul>
      </div>
      <div class="menu-card" data-animate>
        <h3 data-i18n="menuPage.tabs.gelato"></h3>
        <ul>
          <li>Pistazie Bronte</li>
          <li>Stracciatella</li>
          <li>Haselnuss Gianduja</li>
        </ul>
      </div>
      <div class="menu-card" data-animate>
        <h3 data-i18n="menuPage.tabs.desserts"></h3>
        <ul>
          <li>Spaghetti Ice Classic</li>
          <li>Waffel mit Gelato</li>
          <li>Waffel mit Fruechten</li>
        </ul>
      </div>
    </div>
    <div class="menu-cta" data-animate>
      <a class="btn btn-call" href="/menu" data-i18n="cta.menu"></a>
    </div>
  </section>

  <section class="story">
    <div class="section-head" data-animate>
      <h2 data-i18n="storyTitle"></h2>
      <p data-i18n="storyIntro"></p>
    </div>
    <div class="story-grid" data-animate>
      <div class="story-item">
        <span>01</span>
        <p data-i18n="storyItems.0"></p>
      </div>
      <div class="story-item">
        <span>02</span>
        <p data-i18n="storyItems.1"></p>
      </div>
      <div class="story-item">
        <span>03</span>
        <p data-i18n="storyItems.2"></p>
      </div>
    </div>
  </section>

  <section class="testimonial-section" data-animate>
    <div class="section-head">
      <h2 data-i18n="testimonialsTitle"></h2>
      <p data-i18n="testimonialsIntro"></p>
    </div>
    <div class="testimonial-grid">
      <article class="testimonial-card">
        <p data-i18n="testimonials.0.quote"></p>
        <span data-i18n="testimonials.0.name"></span>
      </article>
      <article class="testimonial-card">
        <p data-i18n="testimonials.1.quote"></p>
        <span data-i18n="testimonials.1.name"></span>
      </article>
      <article class="testimonial-card">
        <p data-i18n="testimonials.2.quote"></p>
        <span data-i18n="testimonials.2.name"></span>
      </article>
    </div>
  </section>

  <section class="faq-section" data-animate>
    <div class="section-head">
      <h2 data-i18n="faqTitle"></h2>
    </div>
    <div class="faq-grid">
      <div class="faq-item">
        <h3 data-i18n="faq.0.q"></h3>
        <p data-i18n="faq.0.a"></p>
      </div>
      <div class="faq-item">
        <h3 data-i18n="faq.1.q"></h3>
        <p data-i18n="faq.1.a"></p>
      </div>
      <div class="faq-item">
        <h3 data-i18n="faq.2.q"></h3>
        <p data-i18n="faq.2.a"></p>
      </div>
    </div>
  </section>

  <section class="newsletter" data-animate>
    <div>
      <h2 data-i18n="newsletter.title"></h2>
      <p data-i18n="newsletter.desc"></p>
    </div>
    <form class="newsletter-form">
      <input type="email" placeholder="Email" aria-label="Email" />
      <button type="button" data-i18n="newsletter.action"></button>
    </form>
  </section>

  <section class="opening-hours" aria-labelledby="opening-hours-title">
    <div class="section-head" data-animate>
      <p class="eyebrow" data-i18n="openingHoursEyebrow"></p>
      <h2 id="opening-hours-title" data-i18n="openingHoursTitle"></h2>
      <p class="note" data-i18n="hoursNote"></p>
    </div>
    <div class="hours-grid" data-animate>
      <% hoursCards.forEach((entry) => { %>
        <article class="day-card <%= entry.isClosed ? 'closed' : '' %>">
          <h3><%= entry.day %></h3>
          <% if (entry.isClosed) { %>
            <p data-i18n="openingClosed"></p>
          <% } else { %>
            <% entry.times.forEach((slot) => { %>
              <p><%= slot %></p>
            <% }) %>
          <% } %>
        </article>
      <% }) %>
    </div>
  </section>

  <section id="map" class="map">
    <div class="section-head" data-animate>
      <h2 data-i18n="visitTitle"></h2>
      <p><%= site.address %></p>
      <p class="note" data-i18n="hoursNote"></p>
    </div>
    <div class="map-frame" data-animate>
      <iframe
        title="Google Maps"
        loading="lazy"
        allowfullscreen
        referrerpolicy="no-referrer-when-downgrade"
        src="<%= site.mapUrl %>"
      ></iframe>
    </div>
  </section>
</main>

<script src="/js/hero.js"></script>
<%- include('partials/footer') %>
